{
  "manifest_version": 3,
  "name": "Angelo \u2014 page to Figma",
  "version": "0.1.0",
  "description": "Detects the logical blocks of a page (header, sections, sub-sections) and sends them to Figma through the Angelo bridge.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Angelo: blocks \u2192 Figma",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
