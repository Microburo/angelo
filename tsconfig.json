{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@figma", "./node_modules/@types"],
    "types": ["plugin-typings"]
  },
  "include": ["plugin/src/**/*.ts"]
}
